# Frontend Next.js — copier vers .env.local. Les variables NEXT_PUBLIC_* sont visibles
# dans le navigateur : n'y mettre aucun secret. Les secrets vont dans backend/.env.

# URL publique du site (métadonnées, liens canoniques)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API Express (/backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Facultatif : origine de l'API vers laquelle le site relaie /api/auth et /api/v1 (connexion, avis).
# Par défaut, déduite de NEXT_PUBLIC_API_BASE_URL. Côté API, BETTER_AUTH_URL = l'URL de ce site.
# API_ORIGIN=http://localhost:5000

# Le numéro WhatsApp, l'e-mail et tout le contenu viennent de MongoDB (réglages du site), pas d'ici.

# Phases suivantes :
# NEXT_PUBLIC_UPLOADTHING_URL=http://localhost:5000/api/uploadthing
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_SENTRY_DSN=
